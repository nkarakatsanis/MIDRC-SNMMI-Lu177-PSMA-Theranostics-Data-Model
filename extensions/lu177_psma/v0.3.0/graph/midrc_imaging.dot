pt_series_file -> imaging_study [id="edge_pt_series_file_imaging_studies",color="#a66e29",style="dashed",tooltip="pt_series_file.imaging_studies → imaging_study | many_to_one | member of required alternative group"];
acquisition -> imaging_study [id="edge_acquisition_imaging_studies",color="#385d7e",style="solid",tooltip="acquisition.imaging_studies → imaging_study | many_to_one | required"];
acquisition -> pt_series_file [id="edge_acquisition_pt_series_files",color="#a7b4bf",style="dashed",tooltip="acquisition.pt_series_files → pt_series_file | many_to_one | optional"];
acquisition -> nm_series_file [id="edge_acquisition_nm_series_files",color="#a7b4bf",style="dashed",tooltip="acquisition.nm_series_files → nm_series_file | many_to_one | optional"];
acquisition -> ct_series_file [id="edge_acquisition_ct_series_files",color="#a7b4bf",style="dashed",tooltip="acquisition.ct_series_files → ct_series_file | many_to_one | optional"];
administration -> case [id="edge_administration_cases",color="#385d7e",style="solid",tooltip="administration.cases → case | many_to_one | required"];
reconstruction -> acquisition [id="edge_reconstruction_acquisitions",color="#385d7e",style="solid",tooltip="reconstruction.acquisitions → acquisition | many_to_one | required"];
