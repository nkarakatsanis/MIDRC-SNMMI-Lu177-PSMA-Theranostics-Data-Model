digraph model { graph [rankdir=BT, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.65, splines=polyline, fontname="Arial", fontsize=16, label="Existing MIDRC image nodes in the theranostics workflow\nNMMI Lu177-PSMA | v0.3.0 proposal", labelloc=t];
node [shape=box, style="rounded,filled", fontcolor="#142d43", fontname="Arial", fontsize=12, margin="0.14,0.09", penwidth=1.5];
edge [fontname="Arial", fontsize=9, arrowsize=0.65, penwidth=0.9];
annotation [label="annotation",fillcolor="#dbe9f6",color="#265b85",id="node_annotation",tooltip="One annotation/contour execution; its files remain separate artifacts",URL="#node=annotation"];
case [label="case",fillcolor="#dfe6ee",color="#265b85",id="node_case",tooltip="One person per project",URL="#node=case"];
ct_series_file [label="ct series file",fillcolor="#dbe9f6",color="#265b85",id="node_ct_series_file",tooltip="One MIDRC ct series file record",URL="#node=ct_series_file"];
dataset [label="dataset",fillcolor="#ececf4",color="#265b85",id="node_dataset",tooltip="One collection",URL="#node=dataset"];
dicom_annotation_file [label="dicom annotation file",fillcolor="#dbe9f6",color="#265b85",id="node_dicom_annotation_file",tooltip="One MIDRC dicom annotation file record",URL="#node=dicom_annotation_file"];
imaging_study [label="imaging study",fillcolor="#dbe9f6",color="#265b85",id="node_imaging_study",tooltip="One examination",URL="#node=imaging_study"];
measurement [label="measurement",fillcolor="#dcece6",color="#265b85",id="node_measurement",tooltip="One measured value with context; lab, ROI and anthropometric profiles",URL="#node=measurement"];
nm_series_file [label="nm series file",fillcolor="#dbe9f6",color="#265b85",id="node_nm_series_file",tooltip="One MIDRC nm series file record",URL="#node=nm_series_file"];
pt_series_file [label="pt series file",fillcolor="#dbe9f6",color="#265b85",id="node_pt_series_file",tooltip="One MIDRC pt series file record",URL="#node=pt_series_file"];
acquisition [label="acquisition",fillcolor="#dbe9f6",color="#a66723",id="node_acquisition",tooltip="One acquisition settings block",URL="#node=acquisition"];
administration [label="administration",fillcolor="#ffebbd",color="#a66723",id="node_administration",tooltip="One actual administration event",URL="#node=administration"];
reconstruction [label="reconstruction",fillcolor="#dbe9f6",color="#a66723",id="node_reconstruction",tooltip="One execution",URL="#node=reconstruction"];
annotation -> dataset [id="edge_annotation_datasets",color="#a66e29",style="dashed",tooltip="annotation.datasets → dataset | many_to_one | member of required alternative group"];
annotation -> case [id="edge_annotation_cases",color="#a66e29",style="dashed",tooltip="annotation.cases → case | many_to_one | member of required alternative group"];
annotation -> imaging_study [id="edge_annotation_imaging_studies",color="#a66e29",style="dashed",tooltip="annotation.imaging_studies → imaging_study | many_to_one | member of required alternative group"];
