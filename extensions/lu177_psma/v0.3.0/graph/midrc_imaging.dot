annotation -> pt_series_file [id="edge_annotation_pt_series_files",color="#a66e29",style="dashed",tooltip="annotation.pt_series_files → pt_series_file | many_to_one | member of required alternative group"];
annotation -> dicom_annotation_file [id="edge_annotation_dicom_annotation_files",color="#a66e29",style="dashed",tooltip="annotation.dicom_annotation_files → dicom_annotation_file | many_to_one | member of required alternative group"];
annotation -> pt_series_file [id="edge_annotation_anatomic_reference_pt_series_files",color="#a7b4bf",style="dashed",tooltip="annotation.anatomic_reference_pt_series_files → pt_series_file | many_to_one | optional"];
annotation -> nm_series_file [id="edge_annotation_anatomic_reference_nm_series_files",color="#a7b4bf",style="dashed",tooltip="annotation.anatomic_reference_nm_series_files → nm_series_file | many_to_one | optional"];
annotation -> ct_series_file [id="edge_annotation_anatomic_reference_ct_series_files",color="#a7b4bf",style="dashed",tooltip="annotation.anatomic_reference_ct_series_files → ct_series_file | many_to_one | optional"];
case -> dataset [id="edge_case_datasets",color="#385d7e",style="solid",tooltip="case.datasets → dataset | many_to_many | required"];
ct_series_file -> imaging_study [id="edge_ct_series_file_imaging_studies",color="#a66e29",style="dashed",tooltip="ct_series_file.imaging_studies → imaging_study | many_to_one | member of required alternative group"];
dicom_annotation_file -> imaging_study [id="edge_dicom_annotation_file_imaging_studies",color="#385d7e",style="solid",tooltip="dicom_annotation_file.imaging_studies → imaging_study | many_to_one | required"];
imaging_study -> case [id="edge_imaging_study_cases",color="#385d7e",style="solid",tooltip="imaging_study.cases → case | many_to_one | required"];
