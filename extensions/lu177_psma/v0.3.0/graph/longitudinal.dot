digraph model { graph [rankdir=BT, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.65, splines=polyline, fontname="Arial", fontsize=16, label="Subject, collection and treatment context\nNMMI Lu177-PSMA | v0.3.0 proposal", labelloc=t];
node [shape=box, style="rounded,filled", fontcolor="#142d43", fontname="Arial", fontsize=12, margin="0.14,0.09", penwidth=1.5];
edge [fontname="Arial", fontsize=9, arrowsize=0.65, penwidth=0.9];
case [label="case",fillcolor="#dfe6ee",color="#265b85",id="node_case",tooltip="One person per project",URL="#node=case"];
dataset [label="dataset",fillcolor="#ececf4",color="#265b85",id="node_dataset",tooltip="One collection",URL="#node=dataset"];
program [label="program",fillcolor="#ececf4",color="#265b85",id="node_program",tooltip="One initiative",URL="#node=program"];
project [label="project",fillcolor="#ececf4",color="#265b85",id="node_project",tooltip="One access-controlled project",URL="#node=project"];
visit [label="visit",fillcolor="#e9def4",color="#265b85",id="node_visit",tooltip="One encounter",URL="#node=visit"];
therapy_course [label="therapy course",fillcolor="#e9def4",color="#a66723",id="node_therapy_course",tooltip="One course per case",URL="#node=therapy_course"];
timepoint [label="timepoint",fillcolor="#e9def4",color="#a66723",id="node_timepoint",tooltip="One time anchor or assessment window",URL="#node=timepoint"];
treatment_plan [label="treatment plan",fillcolor="#ffebbd",color="#a66723",id="node_treatment_plan",tooltip="One plan version",URL="#node=treatment_plan"];
radiopharmaceutical_batch [label="radiopharmaceutical batch",fillcolor="#ffebbd",color="#a66723",id="node_radiopharmaceutical_batch",tooltip="One batch or lot",URL="#node=radiopharmaceutical_batch"];
radiopharmaceutical [label="radiopharmaceutical",fillcolor="#ffebbd",color="#a66723",id="node_radiopharmaceutical",tooltip="One product identity",URL="#node=radiopharmaceutical"];
study [label="study",fillcolor="#e9def4",color="#a66723",id="node_study",tooltip="One protocol version",URL="#node=study"];
site [label="site",fillcolor="#ececf4",color="#a66723",id="node_site",tooltip="One site",URL="#node=site"];
administration [label="administration",fillcolor="#ffebbd",color="#a66723",id="node_administration",tooltip="One actual administration event",URL="#node=administration"];
therapy_cycle [label="therapy cycle",fillcolor="#e9def4",color="#a66723",id="node_therapy_cycle",tooltip="One course and cycle number",URL="#node=therapy_cycle"];
eligibility_assessment [label="eligibility assessment",fillcolor="#dcece6",color="#a66723",id="node_eligibility_assessment",tooltip="One eligibility assessment and criteria version",URL="#node=eligibility_assessment"];
treatment_decision [label="treatment decision",fillcolor="#ffebbd",color="#a66723",id="node_treatment_decision",tooltip="One decision at a specified time",URL="#node=treatment_decision"];
treatment_transition [label="treatment transition",fillcolor="#e9def4",color="#a66723",id="node_treatment_transition",tooltip="One transition or follow-up status assessment",URL="#node=treatment_transition"];
case -> dataset [id="edge_case_datasets",color="#385d7e",style="solid",tooltip="case.datasets → dataset | many_to_many | required"];
case -> site [id="edge_case_sites",color="#a7b4bf",style="dashed",tooltip="case.sites → site | many_to_one | optional"];
dataset -> project [id="edge_dataset_projects",color="#385d7e",style="solid",tooltip="dataset.projects → project | many_to_one | required"];
project -> program [id="edge_project_programs",color="#385d7e",style="solid",tooltip="project.programs → program | many_to_one | required"];
visit -> case [id="edge_visit_cases",color="#385d7e",style="solid",tooltip="visit.cases → case | many_to_one | required"];
therapy_course -> case [id="edge_therapy_course_cases",color="#385d7e",style="solid",tooltip="therapy_course.cases → case | many_to_one | required"];
therapy_course -> study [id="edge_therapy_course_studies",color="#a7b4bf",style="dashed",tooltip="therapy_course.studies → study | many_to_one | optional"];
timepoint -> therapy_course [id="edge_timepoint_therapy_courses",color="#385d7e",style="solid",tooltip="timepoint.therapy_courses → therapy_course | many_to_one | required"];
timepoint -> therapy_cycle [id="edge_timepoint_therapy_cycles",color="#a7b4bf",style="dashed",tooltip="timepoint.therapy_cycles → therapy_cycle | many_to_one | optional"];
timepoint -> administration [id="edge_timepoint_anchor_administrations",color="#a7b4bf",style="dashed",tooltip="timepoint.anchor_administrations → administration | many_to_one | optional"];
treatment_plan -> therapy_course [id="edge_treatment_plan_therapy_courses",color="#385d7e",style="solid",tooltip="treatment_plan.therapy_courses → therapy_course | many_to_one | required"];
treatment_plan -> therapy_cycle [id="edge_treatment_plan_therapy_cycles",color="#a7b4bf",style="dashed",tooltip="treatment_plan.therapy_cycles → therapy_cycle | many_to_one | optional"];
treatment_plan -> eligibility_assessment [id="edge_treatment_plan_eligibility_assessments",color="#a7b4bf",style="dashed",tooltip="treatment_plan.eligibility_assessments → eligibility_assessment | many_to_many | optional"];
radiopharmaceutical_batch -> radiopharmaceutical [id="edge_radiopharmaceutical_batch_radiopharmaceuticals",color="#385d7e",style="solid",tooltip="radiopharmaceutical_batch.radiopharmaceuticals → radiopharmaceutical | many_to_one | required"];
radiopharmaceutical -> project [id="edge_radiopharmaceutical_projects",color="#385d7e",style="solid",tooltip="radiopharmaceutical.projects → project | many_to_one | required"];
study -> project [id="edge_study_projects",color="#385d7e",style="solid",tooltip="study.projects → project | many_to_one | required"];
site -> project [id="edge_site_projects",color="#385d7e",style="solid",tooltip="site.projects → project | many_to_one | required"];
administration -> case [id="edge_administration_cases",color="#385d7e",style="solid",tooltip="administration.cases → case | many_to_one | required"];
administration -> radiopharmaceutical [id="edge_administration_radiopharmaceuticals",color="#385d7e",style="solid",tooltip="administration.radiopharmaceuticals → radiopharmaceutical | many_to_one | required"];
administration -> radiopharmaceutical_batch [id="edge_administration_radiopharmaceutical_batches",color="#a7b4bf",style="dashed",tooltip="administration.radiopharmaceutical_batches → radiopharmaceutical_batch | many_to_one | optional"];
administration -> therapy_cycle [id="edge_administration_therapy_cycles",color="#a7b4bf",style="dashed",tooltip="administration.therapy_cycles → therapy_cycle | many_to_one | optional"];
administration -> visit [id="edge_administration_visits",color="#a7b4bf",style="dashed",tooltip="administration.visits → visit | many_to_one | optional"];
therapy_cycle -> therapy_course [id="edge_therapy_cycle_therapy_courses",color="#385d7e",style="solid",tooltip="therapy_cycle.therapy_courses → therapy_course | many_to_one | required"];
eligibility_assessment -> case [id="edge_eligibility_assessment_cases",color="#385d7e",style="solid",tooltip="eligibility_assessment.cases → case | many_to_one | required"];
eligibility_assessment -> study [id="edge_eligibility_assessment_studies",color="#a7b4bf",style="dashed",tooltip="eligibility_assessment.studies → study | many_to_one | optional"];
eligibility_assessment -> visit [id="edge_eligibility_assessment_visits",color="#a7b4bf",style="dashed",tooltip="eligibility_assessment.visits → visit | many_to_one | optional"];
eligibility_assessment -> therapy_course [id="edge_eligibility_assessment_therapy_courses",color="#a7b4bf",style="dashed",tooltip="eligibility_assessment.therapy_courses → therapy_course | many_to_one | optional"];
treatment_decision -> therapy_course [id="edge_treatment_decision_therapy_courses",color="#385d7e",style="solid",tooltip="treatment_decision.therapy_courses → therapy_course | many_to_one | required"];
treatment_decision -> therapy_cycle [id="edge_treatment_decision_therapy_cycles",color="#a7b4bf",style="dashed",tooltip="treatment_decision.therapy_cycles → therapy_cycle | many_to_one | optional"];
treatment_decision -> treatment_plan [id="edge_treatment_decision_treatment_plans",color="#a7b4bf",style="dashed",tooltip="treatment_decision.treatment_plans → treatment_plan | many_to_many | optional"];
treatment_transition -> therapy_course [id="edge_treatment_transition_prior_courses",color="#385d7e",style="solid",tooltip="treatment_transition.prior_courses → therapy_course | many_to_one | required"];
treatment_transition -> therapy_course [id="edge_treatment_transition_subsequent_courses",color="#a7b4bf",style="dashed",tooltip="treatment_transition.subsequent_courses → therapy_course | many_to_many | optional"];
treatment_transition -> treatment_decision [id="edge_treatment_transition_treatment_decisions",color="#a7b4bf",style="dashed",tooltip="treatment_transition.treatment_decisions → treatment_decision | many_to_many | optional"];
}