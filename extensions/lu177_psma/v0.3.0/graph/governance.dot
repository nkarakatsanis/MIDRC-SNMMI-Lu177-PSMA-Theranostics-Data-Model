digraph model { graph [rankdir=BT, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.65, splines=polyline, fontname="Arial", fontsize=16, label="Administrative and semantic governance\nNMMI Lu177-PSMA | v0.3.0 proposal", labelloc=t];
node [shape=box, style="rounded,filled", fontcolor="#142d43", fontname="Arial", fontsize=12, margin="0.14,0.09", penwidth=1.5];
edge [fontname="Arial", fontsize=9, arrowsize=0.65, penwidth=0.9];
case [label="case",fillcolor="#dfe6ee",color="#265b85",id="node_case",tooltip="One person per project",URL="#node=case"];
dataset [label="dataset",fillcolor="#ececf4",color="#265b85",id="node_dataset",tooltip="One collection",URL="#node=dataset"];
program [label="program",fillcolor="#ececf4",color="#265b85",id="node_program",tooltip="One initiative",URL="#node=program"];
project [label="project",fillcolor="#ececf4",color="#265b85",id="node_project",tooltip="One access-controlled project",URL="#node=project"];
semantic_mapping [label="semantic mapping",fillcolor="#ececf4",color="#a66723",id="node_semantic_mapping",tooltip="One mapping assertion",URL="#node=semantic_mapping"];
scanner [label="scanner",fillcolor="#dbe9f6",color="#a66723",id="node_scanner",tooltip="One equipment unit",URL="#node=scanner"];
radiopharmaceutical [label="radiopharmaceutical",fillcolor="#ffebbd",color="#a66723",id="node_radiopharmaceutical",tooltip="One product identity",URL="#node=radiopharmaceutical"];
study [label="study",fillcolor="#e9def4",color="#a66723",id="node_study",tooltip="One protocol version",URL="#node=study"];
provenance [label="provenance",fillcolor="#ececf4",color="#a66723",id="node_provenance",tooltip="One provenance assertion",URL="#node=provenance"];
site [label="site",fillcolor="#ececf4",color="#a66723",id="node_site",tooltip="One site",URL="#node=site"];
model_release [label="model release",fillcolor="#ececf4",color="#a66723",id="node_model_release",tooltip="One release",URL="#node=model_release"];
case -> dataset [id="edge_case_datasets",color="#385d7e",style="solid",tooltip="case.datasets → dataset | many_to_many | required"];
case -> site [id="edge_case_sites",color="#a7b4bf",style="dashed",tooltip="case.sites → site | many_to_one | optional"];
case -> provenance [id="edge_case_provenance_records",color="#a7b4bf",style="dashed",tooltip="case.provenance_records → provenance | many_to_many | optional"];
dataset -> project [id="edge_dataset_projects",color="#385d7e",style="solid",tooltip="dataset.projects → project | many_to_one | required"];
project -> program [id="edge_project_programs",color="#385d7e",style="solid",tooltip="project.programs → program | many_to_one | required"];
semantic_mapping -> model_release [id="edge_semantic_mapping_model_releases",color="#385d7e",style="solid",tooltip="semantic_mapping.model_releases → model_release | many_to_one | required"];
scanner -> project [id="edge_scanner_projects",color="#385d7e",style="solid",tooltip="scanner.projects → project | many_to_one | required"];
scanner -> site [id="edge_scanner_sites",color="#a7b4bf",style="dashed",tooltip="scanner.sites → site | many_to_one | optional"];
scanner -> provenance [id="edge_scanner_provenance_records",color="#a7b4bf",style="dashed",tooltip="scanner.provenance_records → provenance | many_to_many | optional"];
radiopharmaceutical -> project [id="edge_radiopharmaceutical_projects",color="#385d7e",style="solid",tooltip="radiopharmaceutical.projects → project | many_to_one | required"];
radiopharmaceutical -> provenance [id="edge_radiopharmaceutical_provenance_records",color="#a7b4bf",style="dashed",tooltip="radiopharmaceutical.provenance_records → provenance | many_to_many | optional"];
study -> project [id="edge_study_projects",color="#385d7e",style="solid",tooltip="study.projects → project | many_to_one | required"];
provenance -> project [id="edge_provenance_projects",color="#385d7e",style="solid",tooltip="provenance.projects → project | many_to_one | required"];
site -> project [id="edge_site_projects",color="#385d7e",style="solid",tooltip="site.projects → project | many_to_one | required"];
model_release -> project [id="edge_model_release_projects",color="#385d7e",style="solid",tooltip="model_release.projects → project | many_to_one | required"];
}