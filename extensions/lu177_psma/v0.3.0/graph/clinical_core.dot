digraph model { graph [rankdir=BT, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.65, splines=polyline, fontname="Arial", fontsize=16, label="Clinical evidence and treatment decisions\nNMMI Lu177-PSMA | v0.3.0 proposal", labelloc=t];
node [shape=box, style="rounded,filled", fontcolor="#142d43", fontname="Arial", fontsize=12, margin="0.14,0.09", penwidth=1.5];
edge [fontname="Arial", fontsize=9, arrowsize=0.65, penwidth=0.9];
case [label="case",fillcolor="#dfe6ee",color="#265b85",id="node_case",tooltip="One person per project",URL="#node=case"];
measurement [label="measurement",fillcolor="#dcece6",color="#265b85",id="node_measurement",tooltip="One measured value with context; lab, ROI and anthropometric profiles",URL="#node=measurement"];
therapy_course [label="therapy course",fillcolor="#e9def4",color="#a66723",id="node_therapy_course",tooltip="One course per case",URL="#node=therapy_course"];
toxicity_event [label="toxicity event",fillcolor="#f8dfd3",color="#a66723",id="node_toxicity_event",tooltip="One adverse-event episode or graded assessment",URL="#node=toxicity_event"];
anatomic_target [label="anatomic target",fillcolor="#d9eff0",color="#a66723",id="node_anatomic_target",tooltip="One tracked lesion or organ per case",URL="#node=anatomic_target"];
response_assessment [label="response assessment",fillcolor="#f8dfd3",color="#a66723",id="node_response_assessment",tooltip="One criteria set and assessment time",URL="#node=response_assessment"];
laboratory_panel [label="laboratory panel",fillcolor="#dcece6",color="#a66723",id="node_laboratory_panel",tooltip="One collected panel or order",URL="#node=laboratory_panel"];
dosimetry [label="dosimetry",fillcolor="#d9eff0",color="#a66723",id="node_dosimetry",tooltip="One calculation run for a cycle or administration",URL="#node=dosimetry"];
administration [label="administration",fillcolor="#ffebbd",color="#a66723",id="node_administration",tooltip="One actual administration event",URL="#node=administration"];
absorbed_dose [label="absorbed dose",fillcolor="#d9eff0",color="#a66723",id="node_absorbed_dose",tooltip="One target, run and dose statistic",URL="#node=absorbed_dose"];
therapy_cycle [label="therapy cycle",fillcolor="#e9def4",color="#a66723",id="node_therapy_cycle",tooltip="One course and cycle number",URL="#node=therapy_cycle"];
eligibility_assessment [label="eligibility assessment",fillcolor="#dcece6",color="#a66723",id="node_eligibility_assessment",tooltip="One eligibility assessment and criteria version",URL="#node=eligibility_assessment"];
treatment_decision [label="treatment decision",fillcolor="#ffebbd",color="#a66723",id="node_treatment_decision",tooltip="One decision at a specified time",URL="#node=treatment_decision"];
measurement -> case [id="edge_measurement_cases",color="#a66e29",style="dashed",tooltip="measurement.cases → case | many_to_one | member of required alternative group"];
measurement -> laboratory_panel [id="edge_measurement_laboratory_panels",color="#a7b4bf",style="dashed",tooltip="measurement.laboratory_panels → laboratory_panel | many_to_one | optional"];
measurement -> anatomic_target [id="edge_measurement_anatomic_targets",color="#a7b4bf",style="dashed",tooltip="measurement.anatomic_targets → anatomic_target | many_to_one | optional"];
therapy_course -> case [id="edge_therapy_course_cases",color="#385d7e",style="solid",tooltip="therapy_course.cases → case | many_to_one | required"];
toxicity_event -> therapy_course [id="edge_toxicity_event_therapy_courses",color="#385d7e",style="solid",tooltip="toxicity_event.therapy_courses → therapy_course | many_to_one | required"];
toxicity_event -> therapy_cycle [id="edge_toxicity_event_therapy_cycles",color="#a7b4bf",style="dashed",tooltip="toxicity_event.therapy_cycles → therapy_cycle | many_to_many | optional"];
toxicity_event -> absorbed_dose [id="edge_toxicity_event_absorbed_doses",color="#a7b4bf",style="dashed",tooltip="toxicity_event.absorbed_doses → absorbed_dose | many_to_many | optional"];
toxicity_event -> measurement [id="edge_toxicity_event_laboratory_measurements",color="#a7b4bf",style="dashed",tooltip="toxicity_event.laboratory_measurements → measurement | many_to_many | optional"];
anatomic_target -> case [id="edge_anatomic_target_cases",color="#385d7e",style="solid",tooltip="anatomic_target.cases → case | many_to_one | required"];
response_assessment -> therapy_course [id="edge_response_assessment_therapy_courses",color="#385d7e",style="solid",tooltip="response_assessment.therapy_courses → therapy_course | many_to_one | required"];
response_assessment -> anatomic_target [id="edge_response_assessment_anatomic_targets",color="#a7b4bf",style="dashed",tooltip="response_assessment.anatomic_targets → anatomic_target | many_to_many | optional"];
response_assessment -> absorbed_dose [id="edge_response_assessment_absorbed_doses",color="#a7b4bf",style="dashed",tooltip="response_assessment.absorbed_doses → absorbed_dose | many_to_many | optional"];
response_assessment -> measurement [id="edge_response_assessment_laboratory_measurements",color="#a7b4bf",style="dashed",tooltip="response_assessment.laboratory_measurements → measurement | many_to_many | optional"];
response_assessment -> measurement [id="edge_response_assessment_roi_measurements",color="#a7b4bf",style="dashed",tooltip="response_assessment.roi_measurements → measurement | many_to_many | optional"];
response_assessment -> measurement [id="edge_response_assessment_baseline_psa_results",color="#a7b4bf",style="dashed",tooltip="response_assessment.baseline_psa_results → measurement | many_to_one | optional"];
response_assessment -> measurement [id="edge_response_assessment_nadir_psa_results",color="#a7b4bf",style="dashed",tooltip="response_assessment.nadir_psa_results → measurement | many_to_one | optional"];
response_assessment -> measurement [id="edge_response_assessment_confirmatory_psa_results",color="#a7b4bf",style="dashed",tooltip="response_assessment.confirmatory_psa_results → measurement | many_to_one | optional"];
laboratory_panel -> case [id="edge_laboratory_panel_cases",color="#385d7e",style="solid",tooltip="laboratory_panel.cases → case | many_to_one | required"];
dosimetry -> therapy_cycle [id="edge_dosimetry_therapy_cycles",color="#385d7e",style="solid",tooltip="dosimetry.therapy_cycles → therapy_cycle | many_to_one | required"];
dosimetry -> administration [id="edge_dosimetry_administrations",color="#a7b4bf",style="dashed",tooltip="dosimetry.administrations → administration | many_to_many | optional"];
administration -> case [id="edge_administration_cases",color="#385d7e",style="solid",tooltip="administration.cases → case | many_to_one | required"];
administration -> therapy_cycle [id="edge_administration_therapy_cycles",color="#a7b4bf",style="dashed",tooltip="administration.therapy_cycles → therapy_cycle | many_to_one | optional"];
absorbed_dose -> dosimetry [id="edge_absorbed_dose_dosimetries",color="#385d7e",style="solid",tooltip="absorbed_dose.dosimetries → dosimetry | many_to_one | required"];
absorbed_dose -> anatomic_target [id="edge_absorbed_dose_anatomic_targets",color="#385d7e",style="solid",tooltip="absorbed_dose.anatomic_targets → anatomic_target | many_to_one | required"];
therapy_cycle -> therapy_course [id="edge_therapy_cycle_therapy_courses",color="#385d7e",style="solid",tooltip="therapy_cycle.therapy_courses → therapy_course | many_to_one | required"];
eligibility_assessment -> case [id="edge_eligibility_assessment_cases",color="#385d7e",style="solid",tooltip="eligibility_assessment.cases → case | many_to_one | required"];
eligibility_assessment -> therapy_course [id="edge_eligibility_assessment_therapy_courses",color="#a7b4bf",style="dashed",tooltip="eligibility_assessment.therapy_courses → therapy_course | many_to_one | optional"];
eligibility_assessment -> measurement [id="edge_eligibility_assessment_laboratory_measurements",color="#a7b4bf",style="dashed",tooltip="eligibility_assessment.laboratory_measurements → measurement | many_to_many | optional"];
treatment_decision -> therapy_course [id="edge_treatment_decision_therapy_courses",color="#385d7e",style="solid",tooltip="treatment_decision.therapy_courses → therapy_course | many_to_one | required"];
treatment_decision -> therapy_cycle [id="edge_treatment_decision_therapy_cycles",color="#a7b4bf",style="dashed",tooltip="treatment_decision.therapy_cycles → therapy_cycle | many_to_one | optional"];
treatment_decision -> response_assessment [id="edge_treatment_decision_response_assessments",color="#a7b4bf",style="dashed",tooltip="treatment_decision.response_assessments → response_assessment | many_to_many | optional"];
treatment_decision -> toxicity_event [id="edge_treatment_decision_toxicity_events",color="#a7b4bf",style="dashed",tooltip="treatment_decision.toxicity_events → toxicity_event | many_to_many | optional"];
}