digraph model { graph [rankdir=BT, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.65, splines=polyline, fontname="Arial", fontsize=16, label="Lesion dose: patient, cycle and imaging evidence\nNMMI Lu177-PSMA | v0.3.0 proposal", labelloc=t];
node [shape=box, style="rounded,filled", fontcolor="#142d43", fontname="Arial", fontsize=12, margin="0.14,0.09", penwidth=1.5];
edge [fontname="Arial", fontsize=9, arrowsize=0.65, penwidth=0.9];
annotation [label="annotation",fillcolor="#dbe9f6",color="#265b85",id="node_annotation",tooltip="One annotation/contour execution; its files remain separate artifacts",URL="#node=annotation"];
case [label="case",fillcolor="#dfe6ee",color="#265b85",id="node_case",tooltip="One person per project",URL="#node=case"];
ct_series_file [label="ct series file",fillcolor="#dbe9f6",color="#265b85",id="node_ct_series_file",tooltip="One MIDRC ct series file record",URL="#node=ct_series_file"];
imaging_study [label="imaging study",fillcolor="#dbe9f6",color="#265b85",id="node_imaging_study",tooltip="One examination",URL="#node=imaging_study"];
nm_series_file [label="nm series file",fillcolor="#dbe9f6",color="#265b85",id="node_nm_series_file",tooltip="One MIDRC nm series file record",URL="#node=nm_series_file"];
therapy_course [label="therapy course",fillcolor="#e9def4",color="#a66723",id="node_therapy_course",tooltip="One course per case",URL="#node=therapy_course"];
anatomic_target [label="anatomic target",fillcolor="#d9eff0",color="#a66723",id="node_anatomic_target",tooltip="One tracked lesion or organ per case",URL="#node=anatomic_target"];
acquisition [label="acquisition",fillcolor="#dbe9f6",color="#a66723",id="node_acquisition",tooltip="One acquisition settings block",URL="#node=acquisition"];
dosimetry [label="dosimetry",fillcolor="#d9eff0",color="#a66723",id="node_dosimetry",tooltip="One calculation run for a cycle or administration",URL="#node=dosimetry"];
absorbed_dose [label="absorbed dose",fillcolor="#d9eff0",color="#a66723",id="node_absorbed_dose",tooltip="One target, run and dose statistic",URL="#node=absorbed_dose"];
therapy_cycle [label="therapy cycle",fillcolor="#e9def4",color="#a66723",id="node_therapy_cycle",tooltip="One course and cycle number",URL="#node=therapy_cycle"];
annotation -> case [id="edge_annotation_cases",color="#a66e29",style="dashed",tooltip="annotation.cases → case | many_to_one | member of required alternative group"];
annotation -> imaging_study [id="edge_annotation_imaging_studies",color="#a66e29",style="dashed",tooltip="annotation.imaging_studies → imaging_study | many_to_one | member of required alternative group"];
annotation -> nm_series_file [id="edge_annotation_nm_series_files",color="#a66e29",style="dashed",tooltip="annotation.nm_series_files → nm_series_file | many_to_one | member of required alternative group"];
annotation -> anatomic_target [id="edge_annotation_anatomic_targets",color="#a7b4bf",style="dashed",tooltip="annotation.anatomic_targets → anatomic_target | many_to_one | optional"];
annotation -> ct_series_file [id="edge_annotation_anatomic_reference_ct_series_files",color="#a7b4bf",style="dashed",tooltip="annotation.anatomic_reference_ct_series_files → ct_series_file | many_to_one | optional"];
ct_series_file -> imaging_study [id="edge_ct_series_file_imaging_studies",color="#a66e29",style="dashed",tooltip="ct_series_file.imaging_studies → imaging_study | many_to_one | member of required alternative group"];
imaging_study -> case [id="edge_imaging_study_cases",color="#385d7e",style="solid",tooltip="imaging_study.cases → case | many_to_one | required"];
nm_series_file -> imaging_study [id="edge_nm_series_file_imaging_studies",color="#a66e29",style="dashed",tooltip="nm_series_file.imaging_studies → imaging_study | many_to_one | member of required alternative group"];
therapy_course -> case [id="edge_therapy_course_cases",color="#385d7e",style="solid",tooltip="therapy_course.cases → case | many_to_one | required"];
anatomic_target -> case [id="edge_anatomic_target_cases",color="#385d7e",style="solid",tooltip="anatomic_target.cases → case | many_to_one | required"];
acquisition -> imaging_study [id="edge_acquisition_imaging_studies",color="#385d7e",style="solid",tooltip="acquisition.imaging_studies → imaging_study | many_to_one | required"];
acquisition -> nm_series_file [id="edge_acquisition_nm_series_files",color="#a7b4bf",style="dashed",tooltip="acquisition.nm_series_files → nm_series_file | many_to_one | optional"];
dosimetry -> therapy_cycle [id="edge_dosimetry_therapy_cycles",color="#385d7e",style="solid",tooltip="dosimetry.therapy_cycles → therapy_cycle | many_to_one | required"];
dosimetry -> acquisition [id="edge_dosimetry_acquisitions",color="#a7b4bf",style="dashed",tooltip="dosimetry.acquisitions → acquisition | many_to_many | optional"];
dosimetry -> nm_series_file [id="edge_dosimetry_nm_series_files",color="#a7b4bf",style="dashed",tooltip="dosimetry.nm_series_files → nm_series_file | many_to_many | optional"];
dosimetry -> annotation [id="edge_dosimetry_annotations",color="#a7b4bf",style="dashed",tooltip="dosimetry.annotations → annotation | many_to_many | optional"];
absorbed_dose -> dosimetry [id="edge_absorbed_dose_dosimetries",color="#385d7e",style="solid",tooltip="absorbed_dose.dosimetries → dosimetry | many_to_one | required"];
absorbed_dose -> anatomic_target [id="edge_absorbed_dose_anatomic_targets",color="#385d7e",style="solid",tooltip="absorbed_dose.anatomic_targets → anatomic_target | many_to_one | required"];
absorbed_dose -> annotation [id="edge_absorbed_dose_annotations",color="#a7b4bf",style="dashed",tooltip="absorbed_dose.annotations → annotation | many_to_many | optional"];
therapy_cycle -> therapy_course [id="edge_therapy_cycle_therapy_courses",color="#385d7e",style="solid",tooltip="therapy_cycle.therapy_courses → therapy_course | many_to_one | required"];
}