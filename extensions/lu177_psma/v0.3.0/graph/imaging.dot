digraph model { graph [rankdir=BT, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.65, splines=polyline, fontname="Arial", fontsize=16, label="Acquisition, processing, contours and dosimetry\nNMMI Lu177-PSMA | v0.3.0 proposal", labelloc=t];
