{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "radiopharmaceutical_order",
  "title": "Radiopharmaceutical Order",
  "type": "object",
  "namespace": "urn:nmmi:lu177-psma:model",
  "category": "clinical",
  "program": "*",
  "project": "*",
  "description": "One procurement request or patient-specific prescription, explicitly distinguished by order_kind.",
  "additionalProperties": false,
  "submittable": true,
  "validators": null,
  "links": [
    {
      "name": "projects",
      "backref": "nmmi_radiopharmaceutical_order_projects",
      "label": "member_of",
      "target_type": "project",
      "multiplicity": "many_to_one",
      "required": true
    },
    {
      "name": "provenance_records",
      "backref": "nmmi_radiopharmaceutical_order_provenance_records",
      "label": "documented_by",
      "target_type": "provenance",
      "multiplicity": "many_to_many",
      "required": false
    },
    {
      "name": "medicinal_products",
      "backref": "nmmi_radiopharmaceutical_order_medicinal_products",
      "label": "requests",
      "target_type": "medicinal_product",
      "multiplicity": "many_to_one",
      "required": true
    },
    {
      "name": "product_packages",
      "backref": "nmmi_radiopharmaceutical_order_product_packages",
      "label": "requests_package",
      "target_type": "product_package",
      "multiplicity": "many_to_one",
      "required": false
    },
    {
      "name": "supply_offers",
      "backref": "nmmi_radiopharmaceutical_order_supply_offers",
      "label": "uses_offer",
      "target_type": "supply_offer",
      "multiplicity": "many_to_one",
      "required": false
    },
    {
      "name": "cases",
      "backref": "nmmi_radiopharmaceutical_order_cases",
      "label": "for_patient",
      "target_type": "case",
      "multiplicity": "many_to_one",
      "required": false
    },
    {
      "name": "therapy_cycles",
      "backref": "nmmi_radiopharmaceutical_order_therapy_cycles",
      "label": "for_cycle",
      "target_type": "therapy_cycle",
      "multiplicity": "many_to_one",
      "required": false
    }
