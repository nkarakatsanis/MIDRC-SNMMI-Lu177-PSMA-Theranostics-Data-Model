  "required": [
    "type",
    "submitter_id",
    "order_kind",
    "ordered_datetime",
    "order_status",
    "projects",
    "medicinal_products"
  ],
  "uniqueKeys": [
    [
      "id"
    ],
    [
      "project_id",
      "submitter_id"
    ]
