digraph model {
graph [rankdir=BT,bgcolor="white",pad=0.3,nodesep=0.4,ranksep=0.7,splines=polyline,fontname="Arial",fontsize=16,label="Complete merged MIDRC and theranostics graph\nLu177-PSMA | v0.4.0 proposal",labelloc=t];
