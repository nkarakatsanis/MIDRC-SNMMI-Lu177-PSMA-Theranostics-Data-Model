toxicity_event -> measurement [tooltip="toxicity_event.laboratory_measurements \u2192 measurement | many_to_many | optional",style="dashed",color="#a0aeb8"];
patient_reported_outcome -> therapy_course [tooltip="patient_reported_outcome.therapy_courses \u2192 therapy_course | many_to_one | required",style="solid",color="#345674"];
survival_outcome -> therapy_course [tooltip="survival_outcome.therapy_courses \u2192 therapy_course | many_to_one | required",style="solid",color="#345674"];
survival_outcome -> response_assessment [tooltip="survival_outcome.response_assessments \u2192 response_assessment | many_to_many | optional",style="dashed",color="#a0aeb8"];
