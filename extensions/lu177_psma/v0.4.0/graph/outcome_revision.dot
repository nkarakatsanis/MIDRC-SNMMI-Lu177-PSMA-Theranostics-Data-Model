digraph model {
graph [rankdir=BT,bgcolor="white",pad=0.3,nodesep=0.4,ranksep=0.7,splines=polyline,fontname="Arial",fontsize=16,label="Five-dimensional outcome framework and evidence\nLu177-PSMA | v0.4.0 proposal",labelloc=t];
node [shape=box,style="rounded,filled",fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.5];
edge [fontname="Arial",fontsize=9,arrowsize=0.65];
case [label="case",fillcolor="#e5eff7",color="#265b85",tooltip="One person per project",URL="#node=case"];
imaging_study [label="imaging study",fillcolor="#e5eff7",color="#265b85",tooltip="One examination",URL="#node=imaging_study"];
measurement [label="measurement",fillcolor="#e5eff7",color="#265b85",tooltip="One measured value with context; lab, ROI and anthropometric profiles",URL="#node=measurement"];
therapy_course [label="therapy course",fillcolor="#f5ead8",color="#a66723",tooltip="One course per case",URL="#node=therapy_course"];
toxicity_event [label="toxicity event",fillcolor="#f5ead8",color="#a66723",tooltip="One adverse-event episode or graded assessment",URL="#node=toxicity_event"];
anatomic_target [label="anatomic target",fillcolor="#f5ead8",color="#a66723",tooltip="One tracked lesion or organ per case",URL="#node=anatomic_target"];
dose_summary [label="dose summary",fillcolor="#f5ead8",color="#a66723",tooltip="One target and aggregation window",URL="#node=dose_summary"];
patient_reported_outcome [label="patient reported outcome",fillcolor="#f5ead8",color="#a66723",tooltip="One instrument and assessment time",URL="#node=patient_reported_outcome"];
response_assessment [label="response assessment",fillcolor="#f5ead8",color="#a66723",tooltip="One criteria set and assessment time",URL="#node=response_assessment"];
toxicity_summary [label="toxicity summary",fillcolor="#f5ead8",color="#a66723",tooltip="One toxicity term and window",URL="#node=toxicity_summary"];
laboratory_panel [label="laboratory panel",fillcolor="#f5ead8",color="#a66723",tooltip="One collected panel or order",URL="#node=laboratory_panel"];
absorbed_dose [label="absorbed dose",fillcolor="#f5ead8",color="#a66723",tooltip="One target, run and dose statistic",URL="#node=absorbed_dose"];
survival_outcome [label="survival outcome",fillcolor="#f5ead8",color="#a66723",tooltip="One endpoint definition per case and course",URL="#node=survival_outcome"];
disease_burden [label="disease burden",fillcolor="#f5ead8",color="#a66723",tooltip="One imaging examination, scope and quantification method",URL="#node=disease_burden"];
clinical_event [label="clinical event",fillcolor="#f5ead8",color="#a66723",tooltip="One clinical event",URL="#node=clinical_event"];
treatment_decision [label="treatment decision",fillcolor="#f5ead8",color="#a66723",tooltip="One decision at a specified time",URL="#node=treatment_decision"];
treatment_transition [label="treatment transition",fillcolor="#f5ead8",color="#a66723",tooltip="One transition or follow-up status assessment",URL="#node=treatment_transition"];
dose_summary -> therapy_course [tooltip="dose_summary.therapy_courses \u2192 therapy_course | many_to_one | required",style="solid",color="#345674"];
dose_summary -> anatomic_target [tooltip="dose_summary.anatomic_targets \u2192 anatomic_target | many_to_one | required",style="solid",color="#345674"];
dose_summary -> absorbed_dose [tooltip="dose_summary.component_doses \u2192 absorbed_dose | many_to_many | required",style="solid",color="#345674"];
treatment_transition -> therapy_course [tooltip="treatment_transition.prior_courses \u2192 therapy_course | many_to_one | required",style="solid",color="#345674"];
treatment_transition -> therapy_course [tooltip="treatment_transition.subsequent_courses \u2192 therapy_course | many_to_many | optional",style="dashed",color="#a0aeb8"];
treatment_transition -> treatment_decision [tooltip="treatment_transition.treatment_decisions \u2192 treatment_decision | many_to_many | optional",style="dashed",color="#a0aeb8"];
disease_burden -> case [tooltip="disease_burden.cases \u2192 case | many_to_one | required",style="solid",color="#345674"];
