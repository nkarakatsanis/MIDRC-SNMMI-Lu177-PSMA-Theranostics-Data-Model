disease_burden -> anatomic_target [tooltip="disease_burden.included_targets \u2192 anatomic_target | many_to_many | optional",style="dashed",color="#a0aeb8"];
disease_burden -> measurement [tooltip="disease_burden.roi_measurements \u2192 measurement | many_to_many | optional",style="dashed",color="#a0aeb8"];
toxicity_event -> therapy_course [tooltip="toxicity_event.therapy_courses \u2192 therapy_course | many_to_one | required",style="solid",color="#345674"];
