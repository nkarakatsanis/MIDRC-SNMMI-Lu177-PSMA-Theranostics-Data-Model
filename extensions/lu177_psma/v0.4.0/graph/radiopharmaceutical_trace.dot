digraph model {
graph [rankdir=BT,bgcolor="white",pad=0.3,nodesep=0.4,ranksep=0.7,splines=polyline,fontname="Arial",fontsize=16,label="Preparation, quality and the actual administration\nLu177-PSMA | v0.4.0 proposal",labelloc=t];
node [shape=box,style="rounded,filled",fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.5];
edge [fontname="Arial",fontsize=9,arrowsize=0.65];
medicinal_product [label="medicinal product",fillcolor="#f5ead8",color="#a66723",tooltip="One versioned commercial or investigational medicinal-product formulation, distinct from agent, authorization and batch.",URL="#node=medicinal_product"];
product_package [label="product package",fillcolor="#f5ead8",color="#a66723",tooltip="One versioned package specification for a medicinal product, not a physical vial.",URL="#node=product_package"];
material_lot [label="material lot",fillcolor="#f5ead8",color="#a66723",tooltip="One physical lot of a precursor, radionuclide stock or other manufacturing material.",URL="#node=material_lot"];
radiopharmaceutical_batch [label="radiopharmaceutical batch",fillcolor="#f5ead8",color="#a66723",tooltip="One physical manufacturing batch; one or more timed QC results are linked through radiopharmaceutical_test.",URL="#node=radiopharmaceutical_batch"];
preparation_event [label="preparation event",fillcolor="#f5ead8",color="#a66723",tooltip="One actual production, compounding, reconstitution or dilution event with specified inputs and output batch.",URL="#node=preparation_event"];
radiopharmaceutical_unit [label="radiopharmaceutical unit",fillcolor="#f5ead8",color="#a66723",tooltip="One physical vial, syringe or other traceable unit from a batch at a stated calibration time.",URL="#node=radiopharmaceutical_unit"];
radiopharmaceutical_test [label="radiopharmaceutical test",fillcolor="#f5ead8",color="#a66723",tooltip="One nonpatient QC, biological-reference or computational-evaluation result with an explicit subject and method.",URL="#node=radiopharmaceutical_test"];
radiopharmaceutical_order [label="radiopharmaceutical order",fillcolor="#f5ead8",color="#a66723",tooltip="One procurement request or patient-specific prescription, explicitly distinguished by order_kind.",URL="#node=radiopharmaceutical_order"];
dispense_event [label="dispense event",fillcolor="#f5ead8",color="#a66723",tooltip="One patient-specific dispensing event allocating a traceable physical unit to a prescription.",URL="#node=dispense_event"];
administration [label="administration",fillcolor="#f5ead8",color="#a66723",tooltip="One actual administration event",URL="#node=administration"];
therapy_cycle [label="therapy cycle",fillcolor="#f5ead8",color="#a66723",tooltip="One course and cycle number",URL="#node=therapy_cycle"];
case [label="case",fillcolor="#e5eff7",color="#265b85",tooltip="One person per project",URL="#node=case"];
radiopharmaceutical_batch -> medicinal_product [tooltip="radiopharmaceutical_batch.medicinal_products \u2192 medicinal_product | many_to_one | optional",style="dashed",color="#a0aeb8"];
radiopharmaceutical_batch -> material_lot [tooltip="radiopharmaceutical_batch.input_material_lots \u2192 material_lot | many_to_many | optional",style="dashed",color="#a0aeb8"];
administration -> case [tooltip="administration.cases \u2192 case | many_to_one | required",style="solid",color="#345674"];
administration -> radiopharmaceutical_batch [tooltip="administration.radiopharmaceutical_batches \u2192 radiopharmaceutical_batch | many_to_one | optional",style="dashed",color="#a0aeb8"];
administration -> therapy_cycle [tooltip="administration.therapy_cycles \u2192 therapy_cycle | many_to_one | optional",style="dashed",color="#a0aeb8"];
administration -> radiopharmaceutical_unit [tooltip="administration.radiopharmaceutical_units \u2192 radiopharmaceutical_unit | many_to_one | optional",style="dashed",color="#a0aeb8"];
administration -> dispense_event [tooltip="administration.dispense_events \u2192 dispense_event | many_to_one | optional",style="dashed",color="#a0aeb8"];
product_package -> medicinal_product [tooltip="product_package.medicinal_products \u2192 medicinal_product | many_to_one | required",style="solid",color="#345674"];
preparation_event -> material_lot [tooltip="preparation_event.input_material_lots \u2192 material_lot | many_to_many | optional",style="dashed",color="#a0aeb8"];
preparation_event -> radiopharmaceutical_batch [tooltip="preparation_event.input_batches \u2192 radiopharmaceutical_batch | many_to_many | optional",style="dashed",color="#a0aeb8"];
preparation_event -> radiopharmaceutical_batch [tooltip="preparation_event.output_batches \u2192 radiopharmaceutical_batch | many_to_one | required",style="solid",color="#345674"];
radiopharmaceutical_unit -> radiopharmaceutical_batch [tooltip="radiopharmaceutical_unit.radiopharmaceutical_batches \u2192 radiopharmaceutical_batch | many_to_one | required",style="solid",color="#345674"];
radiopharmaceutical_unit -> product_package [tooltip="radiopharmaceutical_unit.product_packages \u2192 product_package | many_to_one | optional",style="dashed",color="#a0aeb8"];
radiopharmaceutical_unit -> preparation_event [tooltip="radiopharmaceutical_unit.preparation_events \u2192 preparation_event | many_to_one | optional",style="dashed",color="#a0aeb8"];
radiopharmaceutical_order -> medicinal_product [tooltip="radiopharmaceutical_order.medicinal_products \u2192 medicinal_product | many_to_one | required",style="solid",color="#345674"];
radiopharmaceutical_order -> product_package [tooltip="radiopharmaceutical_order.product_packages \u2192 product_package | many_to_one | optional",style="dashed",color="#a0aeb8"];
radiopharmaceutical_order -> case [tooltip="radiopharmaceutical_order.cases \u2192 case | many_to_one | optional",style="dashed",color="#a0aeb8"];
radiopharmaceutical_order -> therapy_cycle [tooltip="radiopharmaceutical_order.therapy_cycles \u2192 therapy_cycle | many_to_one | optional",style="dashed",color="#a0aeb8"];
dispense_event -> case [tooltip="dispense_event.cases \u2192 case | many_to_one | required",style="solid",color="#345674"];
dispense_event -> radiopharmaceutical_order [tooltip="dispense_event.radiopharmaceutical_orders \u2192 radiopharmaceutical_order | many_to_one | required",style="solid",color="#345674"];
dispense_event -> radiopharmaceutical_unit [tooltip="dispense_event.radiopharmaceutical_units \u2192 radiopharmaceutical_unit | many_to_one | required",style="solid",color="#345674"];
radiopharmaceutical_test -> radiopharmaceutical_batch [tooltip="radiopharmaceutical_test.radiopharmaceutical_batches \u2192 radiopharmaceutical_batch | many_to_one | optional",style="dashed",color="#a0aeb8"];
radiopharmaceutical_test -> material_lot [tooltip="radiopharmaceutical_test.material_lots \u2192 material_lot | many_to_one | optional",style="dashed",color="#a0aeb8"];
radiopharmaceutical_test -> radiopharmaceutical_unit [tooltip="radiopharmaceutical_test.radiopharmaceutical_units \u2192 radiopharmaceutical_unit | many_to_one | optional",style="dashed",color="#a0aeb8"];
}
