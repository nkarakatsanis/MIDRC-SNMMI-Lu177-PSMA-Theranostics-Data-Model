digraph model {
graph [rankdir=BT,bgcolor="white",pad=0.3,nodesep=0.4,ranksep=0.7,splines=polyline,fontname="Arial",fontsize=16,label="Clinical evidence and treatment decisions\nLu177-PSMA | v0.4.0 proposal",labelloc=t];
node [shape=box,style="rounded,filled",fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.5];
edge [fontname="Arial",fontsize=9,arrowsize=0.65];
case [label="case",fillcolor="#e5eff7",color="#265b85",tooltip="One person per project",URL="#node=case"];
measurement [label="measurement",fillcolor="#e5eff7",color="#265b85",tooltip="One measured value with context; lab, ROI and anthropometric profiles",URL="#node=measurement"];
therapy_course [label="therapy course",fillcolor="#f5ead8",color="#a66723",tooltip="One course per case",URL="#node=therapy_course"];
toxicity_event [label="toxicity event",fillcolor="#f5ead8",color="#a66723",tooltip="One adverse-event episode or graded assessment",URL="#node=toxicity_event"];
anatomic_target [label="anatomic target",fillcolor="#f5ead8",color="#a66723",tooltip="One tracked lesion or organ per case",URL="#node=anatomic_target"];
response_assessment [label="response assessment",fillcolor="#f5ead8",color="#a66723",tooltip="One criteria set and assessment time",URL="#node=response_assessment"];
laboratory_panel [label="laboratory panel",fillcolor="#f5ead8",color="#a66723",tooltip="One collected panel or order",URL="#node=laboratory_panel"];
dosimetry [label="dosimetry",fillcolor="#f5ead8",color="#a66723",tooltip="One calculation run for a cycle or administration",URL="#node=dosimetry"];
administration [label="administration",fillcolor="#f5ead8",color="#a66723",tooltip="One actual administration event",URL="#node=administration"];
absorbed_dose [label="absorbed dose",fillcolor="#f5ead8",color="#a66723",tooltip="One target, run and dose statistic",URL="#node=absorbed_dose"];
therapy_cycle [label="therapy cycle",fillcolor="#f5ead8",color="#a66723",tooltip="One course and cycle number",URL="#node=therapy_cycle"];
eligibility_assessment [label="eligibility assessment",fillcolor="#f5ead8",color="#a66723",tooltip="One eligibility assessment and criteria version",URL="#node=eligibility_assessment"];
treatment_decision [label="treatment decision",fillcolor="#f5ead8",color="#a66723",tooltip="One decision at a specified time",URL="#node=treatment_decision"];
eligibility_assessment -> case [tooltip="eligibility_assessment.cases \u2192 case | many_to_one | required",style="solid",color="#345674"];
eligibility_assessment -> therapy_course [tooltip="eligibility_assessment.therapy_courses \u2192 therapy_course | many_to_one | optional",style="dashed",color="#a0aeb8"];
eligibility_assessment -> measurement [tooltip="eligibility_assessment.laboratory_measurements \u2192 measurement | many_to_many | optional",style="dashed",color="#a0aeb8"];
toxicity_event -> therapy_course [tooltip="toxicity_event.therapy_courses \u2192 therapy_course | many_to_one | required",style="solid",color="#345674"];
toxicity_event -> therapy_cycle [tooltip="toxicity_event.therapy_cycles \u2192 therapy_cycle | many_to_many | optional",style="dashed",color="#a0aeb8"];
toxicity_event -> absorbed_dose [tooltip="toxicity_event.absorbed_doses \u2192 absorbed_dose | many_to_many | optional",style="dashed",color="#a0aeb8"];
toxicity_event -> measurement [tooltip="toxicity_event.laboratory_measurements \u2192 measurement | many_to_many | optional",style="dashed",color="#a0aeb8"];
administration -> case [tooltip="administration.cases \u2192 case | many_to_one | required",style="solid",color="#345674"];
administration -> therapy_cycle [tooltip="administration.therapy_cycles \u2192 therapy_cycle | many_to_one | optional",style="dashed",color="#a0aeb8"];
treatment_decision -> therapy_course [tooltip="treatment_decision.therapy_courses \u2192 therapy_course | many_to_one | required",style="solid",color="#345674"];
treatment_decision -> therapy_cycle [tooltip="treatment_decision.therapy_cycles \u2192 therapy_cycle | many_to_one | optional",style="dashed",color="#a0aeb8"];
treatment_decision -> response_assessment [tooltip="treatment_decision.response_assessments \u2192 response_assessment | many_to_many | optional",style="dashed",color="#a0aeb8"];
treatment_decision -> toxicity_event [tooltip="treatment_decision.toxicity_events \u2192 toxicity_event | many_to_many | optional",style="dashed",color="#a0aeb8"];
measurement -> case [tooltip="measurement.cases \u2192 case | many_to_one | alternative group",style="dashed",color="#a66e29"];
measurement -> laboratory_panel [tooltip="measurement.laboratory_panels \u2192 laboratory_panel | many_to_one | optional",style="dashed",color="#a0aeb8"];
measurement -> anatomic_target [tooltip="measurement.anatomic_targets \u2192 anatomic_target | many_to_one | optional",style="dashed",color="#a0aeb8"];
response_assessment -> therapy_course [tooltip="response_assessment.therapy_courses \u2192 therapy_course | many_to_one | required",style="solid",color="#345674"];
response_assessment -> anatomic_target [tooltip="response_assessment.anatomic_targets \u2192 anatomic_target | many_to_many | optional",style="dashed",color="#a0aeb8"];
response_assessment -> absorbed_dose [tooltip="response_assessment.absorbed_doses \u2192 absorbed_dose | many_to_many | optional",style="dashed",color="#a0aeb8"];
response_assessment -> measurement [tooltip="response_assessment.laboratory_measurements \u2192 measurement | many_to_many | optional",style="dashed",color="#a0aeb8"];
response_assessment -> measurement [tooltip="response_assessment.roi_measurements \u2192 measurement | many_to_many | optional",style="dashed",color="#a0aeb8"];
response_assessment -> measurement [tooltip="response_assessment.baseline_psa_results \u2192 measurement | many_to_one | optional",style="dashed",color="#a0aeb8"];
response_assessment -> measurement [tooltip="response_assessment.nadir_psa_results \u2192 measurement | many_to_one | optional",style="dashed",color="#a0aeb8"];
response_assessment -> measurement [tooltip="response_assessment.confirmatory_psa_results \u2192 measurement | many_to_one | optional",style="dashed",color="#a0aeb8"];
laboratory_panel -> case [tooltip="laboratory_panel.cases \u2192 case | many_to_one | required",style="solid",color="#345674"];
dosimetry -> therapy_cycle [tooltip="dosimetry.therapy_cycles \u2192 therapy_cycle | many_to_one | required",style="solid",color="#345674"];
dosimetry -> administration [tooltip="dosimetry.administrations \u2192 administration | many_to_many | optional",style="dashed",color="#a0aeb8"];
absorbed_dose -> dosimetry [tooltip="absorbed_dose.dosimetries \u2192 dosimetry | many_to_one | required",style="solid",color="#345674"];
absorbed_dose -> anatomic_target [tooltip="absorbed_dose.anatomic_targets \u2192 anatomic_target | many_to_one | required",style="solid",color="#345674"];
therapy_cycle -> therapy_course [tooltip="therapy_cycle.therapy_courses \u2192 therapy_course | many_to_one | required",style="solid",color="#345674"];
anatomic_target -> case [tooltip="anatomic_target.cases \u2192 case | many_to_one | required",style="solid",color="#345674"];
therapy_course -> case [tooltip="therapy_course.cases \u2192 case | many_to_one | required",style="solid",color="#345674"];
}
