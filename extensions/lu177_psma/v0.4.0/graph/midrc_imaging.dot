digraph model {
graph [rankdir=BT,bgcolor="white",pad=0.3,nodesep=0.4,ranksep=0.7,splines=polyline,fontname="Arial",fontsize=16,label="Existing MIDRC image nodes in the theranostics workflow\nLu177-PSMA | v0.4.0 proposal",labelloc=t];
node [shape=box,style="rounded,filled",fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.5];
edge [fontname="Arial",fontsize=9,arrowsize=0.65];
annotation [label="annotation",fillcolor="#e5eff7",color="#265b85",tooltip="One annotation/contour execution; its files remain separate artifacts",URL="#node=annotation"];
case [label="case",fillcolor="#e5eff7",color="#265b85",tooltip="One person per project",URL="#node=case"];
ct_series_file [label="ct series file",fillcolor="#e5eff7",color="#265b85",tooltip="One MIDRC ct series file record",URL="#node=ct_series_file"];
dataset [label="dataset",fillcolor="#e5eff7",color="#265b85",tooltip="One collection",URL="#node=dataset"];
dicom_annotation_file [label="dicom annotation file",fillcolor="#e5eff7",color="#265b85",tooltip="One MIDRC dicom annotation file record",URL="#node=dicom_annotation_file"];
imaging_study [label="imaging study",fillcolor="#e5eff7",color="#265b85",tooltip="One examination",URL="#node=imaging_study"];
measurement [label="measurement",fillcolor="#e5eff7",color="#265b85",tooltip="One measured value with context; lab, ROI and anthropometric profiles",URL="#node=measurement"];
nm_series_file [label="nm series file",fillcolor="#e5eff7",color="#265b85",tooltip="One MIDRC nm series file record",URL="#node=nm_series_file"];
pt_series_file [label="pt series file",fillcolor="#e5eff7",color="#265b85",tooltip="One MIDRC pt series file record",URL="#node=pt_series_file"];
acquisition [label="acquisition",fillcolor="#f5ead8",color="#a66723",tooltip="One acquisition settings block",URL="#node=acquisition"];
administration [label="administration",fillcolor="#f5ead8",color="#a66723",tooltip="One actual administration event",URL="#node=administration"];
reconstruction [label="reconstruction",fillcolor="#f5ead8",color="#a66723",tooltip="One execution",URL="#node=reconstruction"];
case -> dataset [tooltip="case.datasets \u2192 dataset | many_to_many | required",style="solid",color="#345674"];
annotation -> dataset [tooltip="annotation.datasets \u2192 dataset | many_to_one | alternative group",style="dashed",color="#a66e29"];
annotation -> case [tooltip="annotation.cases \u2192 case | many_to_one | alternative group",style="dashed",color="#a66e29"];
annotation -> imaging_study [tooltip="annotation.imaging_studies \u2192 imaging_study | many_to_one | alternative group",style="dashed",color="#a66e29"];
