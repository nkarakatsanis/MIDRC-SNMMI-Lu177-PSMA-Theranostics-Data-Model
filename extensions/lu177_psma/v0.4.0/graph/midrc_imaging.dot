annotation -> nm_series_file [tooltip="annotation.nm_series_files \u2192 nm_series_file | many_to_one | alternative group",style="dashed",color="#a66e29"];
annotation -> pt_series_file [tooltip="annotation.pt_series_files \u2192 pt_series_file | many_to_one | alternative group",style="dashed",color="#a66e29"];
annotation -> dicom_annotation_file [tooltip="annotation.dicom_annotation_files \u2192 dicom_annotation_file | many_to_one | alternative group",style="dashed",color="#a66e29"];
annotation -> pt_series_file [tooltip="annotation.anatomic_reference_pt_series_files \u2192 pt_series_file | many_to_one | optional",style="dashed",color="#a0aeb8"];
annotation -> nm_series_file [tooltip="annotation.anatomic_reference_nm_series_files \u2192 nm_series_file | many_to_one | optional",style="dashed",color="#a0aeb8"];
annotation -> ct_series_file [tooltip="annotation.anatomic_reference_ct_series_files \u2192 ct_series_file | many_to_one | optional",style="dashed",color="#a0aeb8"];
reconstruction -> acquisition [tooltip="reconstruction.acquisitions \u2192 acquisition | many_to_one | required",style="solid",color="#345674"];
reconstruction -> pt_series_file [tooltip="reconstruction.output_pt_series_files \u2192 pt_series_file | many_to_many | optional",style="dashed",color="#a0aeb8"];
reconstruction -> nm_series_file [tooltip="reconstruction.output_nm_series_files \u2192 nm_series_file | many_to_many | optional",style="dashed",color="#a0aeb8"];
reconstruction -> ct_series_file [tooltip="reconstruction.output_ct_series_files \u2192 ct_series_file | many_to_many | optional",style="dashed",color="#a0aeb8"];
ct_series_file -> imaging_study [tooltip="ct_series_file.imaging_studies \u2192 imaging_study | many_to_one | alternative group",style="dashed",color="#a66e29"];
acquisition -> imaging_study [tooltip="acquisition.imaging_studies \u2192 imaging_study | many_to_one | required",style="solid",color="#345674"];
acquisition -> pt_series_file [tooltip="acquisition.pt_series_files \u2192 pt_series_file | many_to_one | optional",style="dashed",color="#a0aeb8"];
acquisition -> nm_series_file [tooltip="acquisition.nm_series_files \u2192 nm_series_file | many_to_one | optional",style="dashed",color="#a0aeb8"];
acquisition -> ct_series_file [tooltip="acquisition.ct_series_files \u2192 ct_series_file | many_to_one | optional",style="dashed",color="#a0aeb8"];
administration -> case [tooltip="administration.cases \u2192 case | many_to_one | required",style="solid",color="#345674"];
pt_series_file -> imaging_study [tooltip="pt_series_file.imaging_studies \u2192 imaging_study | many_to_one | alternative group",style="dashed",color="#a66e29"];
nm_series_file -> imaging_study [tooltip="nm_series_file.imaging_studies \u2192 imaging_study | many_to_one | alternative group",style="dashed",color="#a66e29"];
measurement -> case [tooltip="measurement.cases \u2192 case | many_to_one | alternative group",style="dashed",color="#a66e29"];
measurement -> annotation [tooltip="measurement.annotations \u2192 annotation | many_to_many | optional",style="dashed",color="#a0aeb8"];
dicom_annotation_file -> imaging_study [tooltip="dicom_annotation_file.imaging_studies \u2192 imaging_study | many_to_one | required",style="solid",color="#345674"];
imaging_study -> case [tooltip="imaging_study.cases \u2192 case | many_to_one | required",style="solid",color="#345674"];
imaging_study -> dataset [tooltip="imaging_study.datasets \u2192 dataset | many_to_many | required",style="solid",color="#345674"];
imaging_study -> administration [tooltip="imaging_study.administrations \u2192 administration | many_to_many | optional",style="dashed",color="#a0aeb8"];
}
