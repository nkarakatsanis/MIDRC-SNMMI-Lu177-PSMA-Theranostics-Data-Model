digraph model {
graph [rankdir=BT,bgcolor="white",pad=0.3,nodesep=0.4,ranksep=0.7,splines=polyline,fontname="Arial",fontsize=16,label="Subject, collection and treatment context\nLu177-PSMA | v0.4.0 proposal",labelloc=t];
node [shape=box,style="rounded,filled",fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.5];
edge [fontname="Arial",fontsize=9,arrowsize=0.65];
case [label="case",fillcolor="#e5eff7",color="#265b85",tooltip="One person per project",URL="#node=case"];
dataset [label="dataset",fillcolor="#e5eff7",color="#265b85",tooltip="One collection",URL="#node=dataset"];
program [label="program",fillcolor="#e5eff7",color="#265b85",tooltip="One initiative",URL="#node=program"];
project [label="project",fillcolor="#e5eff7",color="#265b85",tooltip="One access-controlled project",URL="#node=project"];
visit [label="visit",fillcolor="#e5eff7",color="#265b85",tooltip="One encounter",URL="#node=visit"];
therapy_course [label="therapy course",fillcolor="#f5ead8",color="#a66723",tooltip="One course per case",URL="#node=therapy_course"];
timepoint [label="timepoint",fillcolor="#f5ead8",color="#a66723",tooltip="One time anchor or assessment window",URL="#node=timepoint"];
treatment_plan [label="treatment plan",fillcolor="#f5ead8",color="#a66723",tooltip="One plan version",URL="#node=treatment_plan"];
radiopharmaceutical_batch [label="radiopharmaceutical batch",fillcolor="#f5ead8",color="#a66723",tooltip="One physical manufacturing batch; one or more timed QC results are linked through radiopharmaceutical_test.",URL="#node=radiopharmaceutical_batch"];
radiopharmaceutical [label="radiopharmaceutical",fillcolor="#f5ead8",color="#a66723",tooltip="One reference agent in the v0.4 profile. Existing product-like records remain readable; migrate them explicitly rather than silently reinterpreting their identifiers.",URL="#node=radiopharmaceutical"];
study [label="study",fillcolor="#f5ead8",color="#a66723",tooltip="One protocol version",URL="#node=study"];
site [label="site",fillcolor="#f5ead8",color="#a66723",tooltip="One site",URL="#node=site"];
administration [label="administration",fillcolor="#f5ead8",color="#a66723",tooltip="One actual administration event",URL="#node=administration"];
therapy_cycle [label="therapy cycle",fillcolor="#f5ead8",color="#a66723",tooltip="One course and cycle number",URL="#node=therapy_cycle"];
eligibility_assessment [label="eligibility assessment",fillcolor="#f5ead8",color="#a66723",tooltip="One eligibility assessment and criteria version",URL="#node=eligibility_assessment"];
treatment_decision [label="treatment decision",fillcolor="#f5ead8",color="#a66723",tooltip="One decision at a specified time",URL="#node=treatment_decision"];
treatment_transition [label="treatment transition",fillcolor="#f5ead8",color="#a66723",tooltip="One transition or follow-up status assessment",URL="#node=treatment_transition"];
study -> project [tooltip="study.projects \u2192 project | many_to_one | required",style="solid",color="#345674"];
case -> dataset [tooltip="case.datasets \u2192 dataset | many_to_many | required",style="solid",color="#345674"];
case -> site [tooltip="case.sites \u2192 site | many_to_one | optional",style="dashed",color="#a0aeb8"];
treatment_plan -> therapy_course [tooltip="treatment_plan.therapy_courses \u2192 therapy_course | many_to_one | required",style="solid",color="#345674"];
treatment_plan -> therapy_cycle [tooltip="treatment_plan.therapy_cycles \u2192 therapy_cycle | many_to_one | optional",style="dashed",color="#a0aeb8"];
treatment_plan -> eligibility_assessment [tooltip="treatment_plan.eligibility_assessments \u2192 eligibility_assessment | many_to_many | optional",style="dashed",color="#a0aeb8"];
eligibility_assessment -> case [tooltip="eligibility_assessment.cases \u2192 case | many_to_one | required",style="solid",color="#345674"];
eligibility_assessment -> study [tooltip="eligibility_assessment.studies \u2192 study | many_to_one | optional",style="dashed",color="#a0aeb8"];
eligibility_assessment -> visit [tooltip="eligibility_assessment.visits \u2192 visit | many_to_one | optional",style="dashed",color="#a0aeb8"];
eligibility_assessment -> therapy_course [tooltip="eligibility_assessment.therapy_courses \u2192 therapy_course | many_to_one | optional",style="dashed",color="#a0aeb8"];
treatment_transition -> therapy_course [tooltip="treatment_transition.prior_courses \u2192 therapy_course | many_to_one | required",style="solid",color="#345674"];
treatment_transition -> therapy_course [tooltip="treatment_transition.subsequent_courses \u2192 therapy_course | many_to_many | optional",style="dashed",color="#a0aeb8"];
treatment_transition -> treatment_decision [tooltip="treatment_transition.treatment_decisions \u2192 treatment_decision | many_to_many | optional",style="dashed",color="#a0aeb8"];
dataset -> project [tooltip="dataset.projects \u2192 project | many_to_one | required",style="solid",color="#345674"];
radiopharmaceutical_batch -> radiopharmaceutical [tooltip="radiopharmaceutical_batch.radiopharmaceuticals \u2192 radiopharmaceutical | many_to_one | required",style="solid",color="#345674"];
radiopharmaceutical -> project [tooltip="radiopharmaceutical.projects \u2192 project | many_to_one | required",style="solid",color="#345674"];
administration -> case [tooltip="administration.cases \u2192 case | many_to_one | required",style="solid",color="#345674"];
administration -> radiopharmaceutical [tooltip="administration.radiopharmaceuticals \u2192 radiopharmaceutical | many_to_one | required",style="solid",color="#345674"];
administration -> radiopharmaceutical_batch [tooltip="administration.radiopharmaceutical_batches \u2192 radiopharmaceutical_batch | many_to_one | optional",style="dashed",color="#a0aeb8"];
administration -> therapy_cycle [tooltip="administration.therapy_cycles \u2192 therapy_cycle | many_to_one | optional",style="dashed",color="#a0aeb8"];
administration -> visit [tooltip="administration.visits \u2192 visit | many_to_one | optional",style="dashed",color="#a0aeb8"];
treatment_decision -> therapy_course [tooltip="treatment_decision.therapy_courses \u2192 therapy_course | many_to_one | required",style="solid",color="#345674"];
treatment_decision -> therapy_cycle [tooltip="treatment_decision.therapy_cycles \u2192 therapy_cycle | many_to_one | optional",style="dashed",color="#a0aeb8"];
treatment_decision -> treatment_plan [tooltip="treatment_decision.treatment_plans \u2192 treatment_plan | many_to_many | optional",style="dashed",color="#a0aeb8"];
site -> project [tooltip="site.projects \u2192 project | many_to_one | required",style="solid",color="#345674"];
project -> program [tooltip="project.programs \u2192 program | many_to_one | required",style="solid",color="#345674"];
therapy_cycle -> therapy_course [tooltip="therapy_cycle.therapy_courses \u2192 therapy_course | many_to_one | required",style="solid",color="#345674"];
therapy_course -> case [tooltip="therapy_course.cases \u2192 case | many_to_one | required",style="solid",color="#345674"];
therapy_course -> study [tooltip="therapy_course.studies \u2192 study | many_to_one | optional",style="dashed",color="#a0aeb8"];
visit -> case [tooltip="visit.cases \u2192 case | many_to_one | required",style="solid",color="#345674"];
timepoint -> therapy_course [tooltip="timepoint.therapy_courses \u2192 therapy_course | many_to_one | required",style="solid",color="#345674"];
timepoint -> therapy_cycle [tooltip="timepoint.therapy_cycles \u2192 therapy_cycle | many_to_one | optional",style="dashed",color="#a0aeb8"];
timepoint -> administration [tooltip="timepoint.anchor_administrations \u2192 administration | many_to_one | optional",style="dashed",color="#a0aeb8"];
}
