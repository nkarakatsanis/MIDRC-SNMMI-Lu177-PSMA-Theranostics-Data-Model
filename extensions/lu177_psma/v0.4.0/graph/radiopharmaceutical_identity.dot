digraph model {
graph [rankdir=BT,bgcolor="white",pad=0.3,nodesep=0.4,ranksep=0.7,splines=polyline,fontname="Arial",fontsize=16,label="Agent, product, ingredients and identifiers\nLu177-PSMA | v0.4.0 proposal",labelloc=t];
node [shape=box,style="rounded,filled",fontname="Arial",fontsize=11,margin="0.14,0.09",penwidth=1.5];
edge [fontname="Arial",fontsize=9,arrowsize=0.65];
radiopharmaceutical [label="radiopharmaceutical",fillcolor="#f5ead8",color="#a66723",tooltip="One reference agent in the v0.4 profile. Existing product-like records remain readable; migrate them explicitly rather than silently reinterpreting their identifiers.",URL="#node=radiopharmaceutical"];
radionuclide [label="radionuclide",fillcolor="#f5ead8",color="#a66723",tooltip="One nuclide identity and versioned physical reference description, including stable daughters.",URL="#node=radionuclide"];
decay_emission [label="decay emission",fillcolor="#f5ead8",color="#a66723",tooltip="One decay branch or one emission component with a specified energy definition and yield.",URL="#node=decay_emission"];
molecular_entity [label="molecular entity",fillcolor="#f5ead8",color="#a66723",tooltip="One chemically specified substance or molecular component, independent of commercial packaging.",URL="#node=molecular_entity"];
biological_target [label="biological target",fillcolor="#f5ead8",color="#a66723",tooltip="One biological target identity; expression, binding and internalization are contextual evidence records.",URL="#node=biological_target"];
medicinal_product [label="medicinal product",fillcolor="#f5ead8",color="#a66723",tooltip="One versioned commercial or investigational medicinal-product formulation, distinct from agent, authorization and batch.",URL="#node=medicinal_product"];
product_ingredient [label="product ingredient",fillcolor="#f5ead8",color="#a66723",tooltip="One ingredient role and quantity specification in a medicinal-product formulation.",URL="#node=product_ingredient"];
product_package [label="product package",fillcolor="#f5ead8",color="#a66723",tooltip="One versioned package specification for a medicinal product, not a physical vial.",URL="#node=product_package"];
external_identifier [label="external identifier",fillcolor="#f5ead8",color="#a66723",tooltip="One reviewed external identifier assignment to one explicitly typed entity; schema-level ontology mappings remain semantic_mapping records.",URL="#node=external_identifier"];
regulatory_authorization [label="regulatory authorization",fillcolor="#f5ead8",color="#a66723",tooltip="One product-specific regulatory application or authorization state in one jurisdiction at a stated date.",URL="#node=regulatory_authorization"];
theranostic_pair [label="theranostic pair",fillcolor="#f5ead8",color="#a66723",tooltip="One evidence-supported proposed pairing of diagnostic and therapeutic agents; not an assertion of interchangeable kinetics.",URL="#node=theranostic_pair"];
radiopharmaceutical -> radionuclide [tooltip="radiopharmaceutical.radionuclide_records \u2192 radionuclide | many_to_many | optional",style="dashed",color="#a0aeb8"];
radiopharmaceutical -> molecular_entity [tooltip="radiopharmaceutical.molecular_entities \u2192 molecular_entity | many_to_many | optional",style="dashed",color="#a0aeb8"];
radiopharmaceutical -> biological_target [tooltip="radiopharmaceutical.biological_targets \u2192 biological_target | many_to_many | optional",style="dashed",color="#a0aeb8"];
radiopharmaceutical -> molecular_entity [tooltip="radiopharmaceutical.chelators \u2192 molecular_entity | many_to_many | optional",style="dashed",color="#a0aeb8"];
radiopharmaceutical -> molecular_entity [tooltip="radiopharmaceutical.linkers \u2192 molecular_entity | many_to_many | optional",style="dashed",color="#a0aeb8"];
radiopharmaceutical -> molecular_entity [tooltip="radiopharmaceutical.targeting_vectors \u2192 molecular_entity | many_to_many | optional",style="dashed",color="#a0aeb8"];
radiopharmaceutical -> molecular_entity [tooltip="radiopharmaceutical.precursors \u2192 molecular_entity | many_to_many | optional",style="dashed",color="#a0aeb8"];
decay_emission -> radionuclide [tooltip="decay_emission.parent_nuclides \u2192 radionuclide | many_to_one | required",style="solid",color="#345674"];
decay_emission -> radionuclide [tooltip="decay_emission.daughter_nuclides \u2192 radionuclide | many_to_one | optional",style="dashed",color="#a0aeb8"];
medicinal_product -> radiopharmaceutical [tooltip="medicinal_product.radiopharmaceuticals \u2192 radiopharmaceutical | many_to_one | required",style="solid",color="#345674"];
product_ingredient -> medicinal_product [tooltip="product_ingredient.medicinal_products \u2192 medicinal_product | many_to_one | required",style="solid",color="#345674"];
product_ingredient -> molecular_entity [tooltip="product_ingredient.molecular_entities \u2192 molecular_entity | many_to_one | required",style="solid",color="#345674"];
product_package -> medicinal_product [tooltip="product_package.medicinal_products \u2192 medicinal_product | many_to_one | required",style="solid",color="#345674"];
regulatory_authorization -> medicinal_product [tooltip="regulatory_authorization.medicinal_products \u2192 medicinal_product | many_to_one | required",style="solid",color="#345674"];
regulatory_authorization -> medicinal_product [tooltip="regulatory_authorization.reference_products \u2192 medicinal_product | many_to_many | optional",style="dashed",color="#a0aeb8"];
theranostic_pair -> radiopharmaceutical [tooltip="theranostic_pair.diagnostic_agents \u2192 radiopharmaceutical | many_to_one | required",style="solid",color="#345674"];
theranostic_pair -> radiopharmaceutical [tooltip="theranostic_pair.therapeutic_agents \u2192 radiopharmaceutical | many_to_one | required",style="solid",color="#345674"];
external_identifier -> radiopharmaceutical [tooltip="external_identifier.radiopharmaceuticals \u2192 radiopharmaceutical | many_to_one | alternative group",style="dashed",color="#a66e29"];
external_identifier -> radionuclide [tooltip="external_identifier.radionuclides \u2192 radionuclide | many_to_one | alternative group",style="dashed",color="#a66e29"];
external_identifier -> molecular_entity [tooltip="external_identifier.molecular_entities \u2192 molecular_entity | many_to_one | alternative group",style="dashed",color="#a66e29"];
external_identifier -> biological_target [tooltip="external_identifier.biological_targets \u2192 biological_target | many_to_one | alternative group",style="dashed",color="#a66e29"];
external_identifier -> medicinal_product [tooltip="external_identifier.medicinal_products \u2192 medicinal_product | many_to_one | alternative group",style="dashed",color="#a66e29"];
external_identifier -> product_package [tooltip="external_identifier.product_packages \u2192 product_package | many_to_one | alternative group",style="dashed",color="#a66e29"];
external_identifier -> regulatory_authorization [tooltip="external_identifier.regulatory_authorizations \u2192 regulatory_authorization | many_to_one | alternative group",style="dashed",color="#a66e29"];
}
